%global _build_id_links none

Name:           autoruns
Version:        @PACKAGE_VERSION@
Release:        @PACKAGE_RELEASE@%{?dist}
Summary:        Sysinternals autorun and persistence entry utility

License:        MIT
URL:            https://github.com/microsoft/Autoruns-for-Linux
Source0:        autoruns
Source1:        LICENSE

%description
Autoruns is a command-line utility that reports programs, scripts, services,
timers, and other persistence hooks configured to run automatically on Linux
systems.

%install
rm -rf %{buildroot}
install -D -m 0755 %{SOURCE0} %{buildroot}%{_bindir}/autoruns
install -D -m 0644 %{SOURCE1} %{buildroot}%{_licensedir}/autoruns/LICENSE

%files
%{_bindir}/autoruns
%license %{_licensedir}/autoruns/LICENSE